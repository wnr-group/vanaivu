// VANAIVU data model.
// PostgreSQL (Supabase). DATABASE_URL = pooled connection (port 6543, used by the app on Vercel),
// DIRECT_URL = direct connection (port 5432, used by migrations).
// Enum-like fields are stored as strings (documented beside each field) so the schema stays portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          String    @default("CUSTOMER") // CUSTOMER | ADMIN
  googleId      String?   @unique
  resetToken    String?   @unique
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  addresses     Address[]
  avatars       Avatar[]
  measurements  CustomerMeasurement[]
  wishlist      Wishlist?
  wardrobe      Wardrobe?
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  tryOnSessions TryOnSession[]
  conversations AIStylistConversation[]
  returns       ReturnRequest[]
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone               String?
  preferredTopSize    String?
  preferredBottomSize String?
  preferredDressSize  String?
  favouriteCategories String   @default("[]") // JSON string[] of category slugs
  stylePreferences    String   @default("[]") // JSON string[]
  fitPreference       String?  // SLIM | REGULAR | RELAXED
  newsletter          Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerMeasurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("My measurements")
  heightCm   Float
  bustCm     Float
  waistCm    Float
  hipCm      Float
  shoulderCm Float
  createdAt  DateTime @default(now())
}

// ───────────────────────────── Avatars ─────────────────────────────

model Avatar {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  isPrimary     Boolean  @default(false)
  provider      String   @default("procedural") // procedural | gltf
  configuration AvatarConfiguration?
  outfits       SavedOutfit[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AvatarConfiguration {
  id          String  @id @default(cuid())
  avatarId    String  @unique
  avatar      Avatar  @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  skinTone    String  // hex
  bodyType    String  // SLIM | ATHLETIC | AVERAGE | CURVY | PLUS
  heightCm    Float
  bustCm      Float
  waistCm     Float
  hipCm       Float
  shoulderCm  Float
  hairStyle   String
  hairColor   String
  faceShape   String  @default("oval")
  accessories String  @default("[]") // JSON string[]
  modelUrl    String? // GLB url when provider = gltf
  details     String  @default("{}") // JSON: full realistic-avatar config (shape, face, hair, eyes)
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model ProductCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  image       String?
  sortOrder   Int               @default(0)
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id])
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  garmentType    String   // TOP | SHIRT | DRESS | JEANS | TROUSERS | SKIRT | JACKET | COORD | ETHNIC | ACTIVE | ACCESSORY
  price          Int      // INR, whole rupees
  compareAtPrice Int?
  material       String
  composition    String
  care           String
  occasion       String   // Casual | Work | Evening | Festive | Party | Vacation | Lounge | Sport
  style          String   // Minimal | Classic | Romantic | Street | Boho | Contemporary | Traditional
  fit            String   // Slim | Regular | Relaxed | Oversized
  sleeve         String   // Sleeveless | Short | Three-quarter | Long | NA
  neckline       String   // Crew | V-neck | Square | Collared | Halter | Off-shoulder | Boat | NA
  pattern        String   // Solid | Floral | Striped | Polka | Embroidered | Printed | Check
  modelInfo      String?
  measurements   String   @default("{}") // JSON: size -> { bust, waist, hip, length }
  rating         Float    @default(0)
  ratingCount    Int      @default(0)
  popularity     Int      @default(0)
  isNew          Boolean  @default(false)
  isTrending     Boolean  @default(false)
  published      Boolean  @default(true)
  tryOnEnabled   Boolean  @default(true)  // 3D studio compatible
  aiTryOnEnabled Boolean  @default(false) // photo try-on compatible
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images       ProductImage[]
  variants     ProductVariant[]
  assets       Product3DAsset[]
  garment      GarmentConfiguration?
  collections  CollectionProduct[]
  reviews      Review[]
  wishlistedBy WishlistItem[]

  @@index([categoryId])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  color     String? // colour name this image belongs to; null = all colours
  kind      String  @default("FRONT") // FRONT | BACK | DETAIL | LIFESTYLE
  sortOrder Int     @default(0)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  color     String
  colorHex  String
  size      String   // XS | S | M | L | XL | XXL | ONE
  priceDelta Int     @default(0) // extra INR for this variant (e.g. plus sizes)
  inventory ProductInventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  outfitItems SavedOutfitItem[]

  @@unique([productId, color, size])
}

model ProductInventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  reserved  Int            @default(0)
  lowStockThreshold Int    @default(3)
  updatedAt DateTime       @updatedAt
}

model Product3DAsset {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String? // variant colour this asset applies to
  kind      String  @default("GARMENT") // GARMENT | TEXTURE
  url       String? // GLB / texture url; null for procedural garments
  format    String  @default("procedural") // glb | gltf | procedural
}

model GarmentConfiguration {
  id           String  @id @default(cuid())
  productId    String  @unique
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  slot         String  // TOP | BOTTOM | FULL | OUTER | ACCESSORY
  silhouette   String  // e.g. "a-line", "bodycon", "wide-leg", "straight", "shirt", "tee", "blazer", "saree"
  lengthRatio  Float   @default(0.5) // 0 = shoulder, 1 = floor
  ease         Float   @default(1.04) // fit ease multiplier over body
  fabric       String  @default("cotton") // drives roughness / sheen
  skeleton     String  @default("vestra-f1") // skeleton compatibility tag
  clothSim     Boolean @default(false)
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  description String
  image       String
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  author    String
  rating    Int
  title     String
  body      String
  sizeBought String?
  fitFeedback String? // Runs small | True to size | Runs large
  createdAt DateTime @default(now())
}

// ───────────────────────────── Content ─────────────────────────────

model Campaign {
  id        String  @id @default(cuid())
  placement String  // HERO | BANNER | ANNOUNCEMENT
  title     String
  subtitle  String?
  body      String?
  image     String?
  ctaLabel  String?
  ctaHref   String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model EditorialStory {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  body      String
  image     String
  author    String
  readMins  Int
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────────── Personalisation ─────────────────────────────

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id            String   @id @default(cuid())
  wishlistId    String
  wishlist      Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAtAdd    Int
  notifyStock   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Wardrobe {
  id      String        @id @default(cuid())
  userId  String        @unique
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfits SavedOutfit[]
  triedOn String        @default("[]") // JSON productId[] recently tried in studio
}

model SavedOutfit {
  id         String            @id @default(cuid())
  wardrobeId String
  wardrobe   Wardrobe          @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  avatarId   String?
  avatar     Avatar?           @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  name       String
  source     String            @default("STUDIO") // STUDIO | STYLIST | CURATED
  items      SavedOutfitItem[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model SavedOutfitItem {
  id        String         @id @default(cuid())
  outfitId  String
  outfit    SavedOutfit    @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  slot      String
}

// ───────────────────────────── Commerce ─────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKey  String?    @unique // cookie token for guest carts
  couponCode String?
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  outfitRef String?        // name of the outfit this item was added from
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  kind        String   // PERCENT | FLAT
  value       Int
  minSubtotal Int      @default(0)
  maxDiscount Int?
  active      Boolean  @default(true)
  expiresAt   DateTime?
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  status          String      @default("PENDING") // PENDING | CONFIRMED | PACKED | SHIPPED | DELIVERED | CANCELLED | RETURNED
  subtotal        Int
  discount        Int         @default(0)
  shippingFee     Int
  total           Int
  couponCode      String?
  shippingMethod  String      // STANDARD | EXPRESS
  shippingAddress String      // JSON snapshot
  items           OrderItem[]
  payments        Payment[]
  shipment        Shipment?
  returns         ReturnRequest[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  image       String
  color       String
  size        String
  unitPrice   Int
  quantity    Int
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   // razorpay | cod
  providerOrderId   String?
  providerPaymentId String?
  status            String   @default("CREATED") // CREATED | CAPTURED | FAILED | REFUNDED
  amount            Int
  createdAt         DateTime @default(now())
  refunds           Refund[]
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier     String   @default("VESTRA Express")
  trackingNo  String?
  status      String   @default("PENDING") // PENDING | PACKED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED
  events      String   @default("[]") // JSON [{status, at, note}]
  eta         DateTime?
  updatedAt   DateTime @updatedAt
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  reason    String
  status    String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | RECEIVED | REFUNDED
  createdAt DateTime @default(now())
}

model Refund {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount    Int
  status    String   @default("PENDING") // PENDING | PROCESSED | FAILED
  providerRefundId String?
  createdAt DateTime @default(now())
}

// ───────────────────────────── AI ─────────────────────────────

model TryOnSession {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl   String        // private storage key
  consentAt  DateTime
  provider   String
  results    TryOnResult[]
  createdAt  DateTime      @default(now())
  deleteAfter DateTime?
}

model TryOnResult {
  id         String       @id @default(cuid())
  sessionId  String
  session    TryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId  String
  status     String       @default("QUEUED") // QUEUED | PROCESSING | SUCCEEDED | FAILED
  jobId      String?
  imageUrl   String?
  error      String?
  saved      Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model AIStylistConversation {
  id        String             @id @default(cuid())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String             @default("New conversation")
  messages  AIStylistMessage[]
  createdAt DateTime           @default(now())
}

model AIStylistMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AIStylistConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String                // user | assistant
  content        String
  productIds     String                @default("[]") // JSON productId[] recommended
  createdAt      DateTime              @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
