# Supabase → Project → Connect → ORMs → Prisma
# Pooled connection (Transaction pooler, port 6543) — used by the app and on Vercel
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / session connection (port 5432) — used only for migrations
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
AUTH_SECRET="dev-only-change-me-7f3c9a1e5b2d4c8a"
# Razorpay (test mode). Leave blank to use the built-in test-payment fallback.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# AI providers (optional)
ANTHROPIC_API_KEY=""
TRYON_PROVIDER=""
TRYON_API_KEY=""
